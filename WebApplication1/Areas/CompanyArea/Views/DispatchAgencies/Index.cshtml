@model IEnumerable<DispatchAgency>

<div class="card">
    <div class="card-header">
        <h3 class="text-info"> List</h3>
    </div>
    <div class="text-danger">
        @TempData["Message"]
    </div>

    <div class="card-body">
        <a asp-action="Create" class="btn btn-success my-3">Create New</a>
        <table class="table table-bordered border-primary">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Main Category Name</th>
                    <th scope="col">Dispatch Agency Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Email Id</th>
                    <th scope="col">Mobile No</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var srno = 1;
                }
                @foreach (var temp in Model)
                {
                    <tr>
                        <th scope="row">@srno</th>
                        <td>@temp.DispatchAgencyName</td>
                        <td>@temp.ContactPersonName</td>
                        <td>@temp.Address</td>
                        <td>@temp.EmailId</td>
                        <td>@temp.ContactNo</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@temp.DispatchAgencyID" class="btn btn-info">Edit</a>
                            <a asp-action="Delete" asp-route-id="@temp.DispatchAgencyID" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    srno++;
                }
            </tbody>
        </table>
    </div>
</div>