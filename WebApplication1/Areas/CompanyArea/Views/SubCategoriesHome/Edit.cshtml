@model SubCategory
<div class="card">
    <div class="card-header">
        <h2 class="text-warning">Edit Sub Category</h2>
    </div>
    <div class="card-body">
        <div class="container mt-4">
            <div class="text-danger">
                @TempData["Message"]
            </div>
            <form asp-action="Edit" method="post">
                <!-- Name -->
                <input type="hidden" asp-for="SubCategoryID" />
                <div class="mb-4">
                    <label class="form-label">Sub Category Name</label>
                    <input class="form-control" asp-for="SubCategoryName">
                    <span class="text-danger" asp-validation-for="SubCategoryName"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label">Main Category Name</label>
                    <select asp-for="MainCategoryID" asp-items="@ViewBag.MainCategories">
                        <option value="0">Select</option>
                    </select>
                    <span class="text-danger" asp-validation-for="SubCategoryName"></span>
                </div>

                <!-- Buttons -->
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        Submit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
