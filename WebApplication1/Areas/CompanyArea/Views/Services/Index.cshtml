@model IEnumerable<Service>

<div class="card">
    <div class="card-header">
        <h3 class="text-info">Service List</h3>
    </div>
    <div class="text-danger">
        @TempData["Message"]
    </div>

    <div class="card-body">
        <a asp-action="Create" class="btn btn-success my-3">Create New</a>
        <table class="table table-bordered border-primary">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Description</th>
                    <th scope="col">Charges</th>
                    <th scope="col">Sub Category</th>
                    <th scope="col">Main Category</th>
                    <th scope="col">ChargesType</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var srno = 1;
                }
                @foreach (var temp in Model)
                {
                    <tr>
                        <th scope="row">@srno</th>
                        <td>@temp.Title</td>
                        <td>@temp.Description</td>
                        <td>@temp.Charges</td>
                        <td>@temp.SubCategory.SubCategoryName</td>
                        <td>@temp.SubCategory.MainCategory.MainCategoryName</td>
                        <td>@temp.ChargesType</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@temp.ServiceID" class="btn btn-info">Edit</a>
                            <a asp-action="Delete" asp-route-id="@temp.ServiceID" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    srno++;
                }
            </tbody>
        </table>
    </div>
</div>